<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">


    <!-- SORT ORDER SECTION -->
    <TextView
        android:id="@+id/areusureText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Are you sure ?"
        android:layout_margin="10dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"/>

    <!-- SORT TYPE SECTION -->
    <TextView
        android:id="@+id/dialogText2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Do you want to move this word to completed list"
        android:layout_margin="10dp"
        android:textSize="15sp"
        android:textColor="#000000"
        android:layout_marginTop="10dp"/>


    <!-- DONE BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginTop="30dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialogBtnNo"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/squared_button"
            android:text="No"
            android:textColor="@android:color/white"
            android:textStyle="bold"/>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dialogBtnYes"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:background="@drawable/squared_button"
            android:text="Yes"
            android:textColor="@android:color/white"
            android:textStyle="bold" />





    </LinearLayout>

</LinearLayout>